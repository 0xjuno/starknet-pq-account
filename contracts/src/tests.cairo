//! Tests for the hybrid account, using genuine falcon.py-signed fixtures from
//! OpenZeppelin cairo-pq-verifiers and a STARK-curve ECDSA signature over the same
//! message ('BENCH_MSG'), generated by `scripts/stark_ecdsa_sign.py`.

use pqbench_falcon_512::fixtures::{poseidon, shake};
use pqbench_falcon_512::{Falcon512PoseidonVerifier, Falcon512ShakeVerifier};
use starknet::SyscallResultTrait;
use starknet::syscalls::deploy_syscall;
use crate::hybrid::{HybridPoseidonAccount, verify_hybrid};
use crate::utils::interface::{
    IHybridAccountDispatcher, IHybridAccountDispatcherTrait, IHybridPublicKeysDispatcher,
    IHybridPublicKeysDispatcherTrait,
};

// STARK-curve ECDSA over msg 'BENCH_MSG' (1222479111879746474823), test key only.
const ECDSA_PK: felt252 = 0x1da8f79d6fd8ef4fb1b9afe8e861eb80b82ec0b022aa28220dad045dc9328a4;
const ECDSA_R: felt252 = 0x3b87908dab2a2c41cd7010c605f6d4aac97108e200e4c8838e1b465db549994;
const ECDSA_S: felt252 = 0x409708fbae771c0d93735659703ededebeb7c20a57226788b2b83d97646826d;

fn hybrid_sig(falcon_sig: Array<felt252>) -> Array<felt252> {
    let mut sig = array![ECDSA_R, ECDSA_S];
    for f in falcon_sig {
        sig.append(f);
    }
    sig
}

fn tamper(mut sig: Array<felt252>, index: u32) -> Array<felt252> {
    let mut out = array![];
    let mut i = 0;
    while let Some(f) = sig.pop_front() {
        if i == index {
            out.append(f + 1);
        } else {
            out.append(f);
        }
        i += 1;
    }
    out
}

#[test]
fn poseidon_valid_hybrid_signature_passes() {
    let sig = hybrid_sig(poseidon::signature());
    assert!(
        verify_hybrid::<
            Falcon512PoseidonVerifier,
        >(poseidon::msg(), ECDSA_PK, poseidon::public_key().span(), sig.span()),
    );
}

#[test]
fn shake_valid_hybrid_signature_passes() {
    let sig = hybrid_sig(shake::signature());
    assert!(
        verify_hybrid::<
            Falcon512ShakeVerifier,
        >(shake::msg(), ECDSA_PK, shake::public_key().span(), sig.span()),
    );
}

#[test]
fn broken_ecdsa_part_fails() {
    // Simulates a forged/invalid classical signature: Falcon alone must not be enough.
    let sig = tamper(hybrid_sig(poseidon::signature()), 1);
    assert!(
        !verify_hybrid::<
            Falcon512PoseidonVerifier,
        >(poseidon::msg(), ECDSA_PK, poseidon::public_key().span(), sig.span()),
    );
}

#[test]
fn broken_falcon_part_fails() {
    // Simulates an attacker who forged ECDSA (e.g. with a quantum computer) but not Falcon.
    let sig = tamper(hybrid_sig(poseidon::signature()), 2 + 29);
    assert!(
        !verify_hybrid::<
            Falcon512PoseidonVerifier,
        >(poseidon::msg(), ECDSA_PK, poseidon::public_key().span(), sig.span()),
    );
}

#[test]
fn ecdsa_only_signature_fails() {
    let sig = array![ECDSA_R, ECDSA_S];
    assert!(
        !verify_hybrid::<
            Falcon512PoseidonVerifier,
        >(poseidon::msg(), ECDSA_PK, poseidon::public_key().span(), sig.span()),
    );
}

#[test]
fn falcon_only_signature_fails() {
    let sig = poseidon::signature();
    assert!(
        !verify_hybrid::<
            Falcon512PoseidonVerifier,
        >(poseidon::msg(), ECDSA_PK, poseidon::public_key().span(), sig.span()),
    );
}

#[test]
fn wrong_message_fails() {
    let sig = hybrid_sig(poseidon::signature());
    assert!(
        !verify_hybrid::<
            Falcon512PoseidonVerifier,
        >(poseidon::msg() + 1, ECDSA_PK, poseidon::public_key().span(), sig.span()),
    );
}

fn deploy_poseidon_account() -> starknet::ContractAddress {
    let mut calldata = array![ECDSA_PK];
    let key = poseidon::public_key();
    calldata.append(key.len().into());
    for k in key {
        calldata.append(k);
    }
    let (address, _) = deploy_syscall(
        HybridPoseidonAccount::TEST_CLASS_HASH, 0, calldata.span(), false,
    )
        .unwrap_syscall();
    address
}

#[test]
fn deployed_account_stores_keys() {
    let address = deploy_poseidon_account();
    let keys = IHybridPublicKeysDispatcher { contract_address: address };
    assert_eq!(keys.get_ecdsa_public_key(), ECDSA_PK);
    assert_eq!(keys.get_falcon_public_key(), poseidon::public_key());
}

#[test]
fn deployed_account_accepts_hybrid_signature() {
    let address = deploy_poseidon_account();
    let account = IHybridAccountDispatcher { contract_address: address };
    let result = account.is_valid_signature(poseidon::msg(), hybrid_sig(poseidon::signature()));
    assert_eq!(result, starknet::VALIDATED);
}

#[test]
fn deployed_account_rejects_ecdsa_only() {
    let address = deploy_poseidon_account();
    let account = IHybridAccountDispatcher { contract_address: address };
    let result = account.is_valid_signature(poseidon::msg(), array![ECDSA_R, ECDSA_S]);
    assert_eq!(result, 0);
}

#[test]
fn validate_accepts_hybrid_transaction() {
    let address = deploy_poseidon_account();
    let account = IHybridAccountDispatcher { contract_address: address };
    starknet::testing::set_transaction_hash(poseidon::msg());
    starknet::testing::set_signature(hybrid_sig(poseidon::signature()).span());
    assert_eq!(account.__validate__(array![]), starknet::VALIDATED);
}

#[test]
#[should_panic]
fn validate_rejects_quantum_forged_ecdsa_only_transaction() {
    let address = deploy_poseidon_account();
    let account = IHybridAccountDispatcher { contract_address: address };
    starknet::testing::set_transaction_hash(poseidon::msg());
    // Valid ECDSA (as a quantum attacker could forge) but tampered Falcon part.
    starknet::testing::set_signature(tamper(hybrid_sig(poseidon::signature()), 2 + 29).span());
    account.__validate__(array![]);
}
